/*
 * SerDes Protocol 1 -  13
 * SerDes Protocol 2 -  5
 * SerDes Protocol 3 -  2
 *
 * Frequencies:
 * Core     -- 2000 MHz
 * Platform -- 700  MHz
 * DDR      -- 2900 MT/s
 */

/*
 * The SerDes protocols, declared before the errata are included so
 * that each of them can drop what this board does not enable.
 */
#define SRDS_PRTCL_S1_VAL 13
#define SRDS_PRTCL_S2_VAL 5
#define SRDS_PRTCL_S3_VAL 2

/* Bitfield definitions, and every erratum this SoC revision needs */
#include <../lx2160asi/lx2160a_rev2_auto_errata.rcwi>

SYS_PLL_RAT=14
MEM_PLL_CFG=3
MEM_PLL_RAT=29
MEM2_PLL_CFG=3
MEM2_PLL_RAT=29
CGA_PLL1_RAT=20
CGA_PLL2_RAT=20
CGB_PLL1_RAT=20
CGB_PLL2_RAT=9
HWA_CGA_M1_CLK_SEL=1
HWA_CGB_M1_CLK_SEL=6
BOOT_LOC=26
SYSCLK_FREQ=600
IIC2_PMUX=6
IIC3_PMUX=2
IIC4_PMUX=2
USB3_CLK_FSEL=39
SRDS_PLL_PD_PLL2=1
SRDS_PLL_PD_PLL5=1
SRDS_DIV_PEX_S1=1
SRDS_DIV_PEX_S2=1
SRDS_DIV_PEX_S3=1

/* Errata to write on scratch reg for validation */
#include <../lx2160asi/scratchrw1.rcw>

/* Modify FlexSPI Clock Divisor value */
#include <../lx2160asi/flexspi_divisor_28.rcw>

/* common PBI commands */
#include <../lx2160asi/common.rcw>

/* Serdes lane equalization settings for 100G */
#include <../lx2160asi/25g_eq_s1_lane_a.rcw>
#include <../lx2160asi/25g_eq_s1_lane_b.rcw>
#include <../lx2160asi/25g_eq_s1_lane_c.rcw>
#include <../lx2160asi/25g_eq_s1_lane_d.rcw>
#include <../lx2160asi/25g_eq_s1_lane_e.rcw>
#include <../lx2160asi/25g_eq_s1_lane_f.rcw>
#include <../lx2160asi/25g_eq_s1_lane_g.rcw>
#include <../lx2160asi/25g_eq_s1_lane_h.rcw>
